# =============================================================================
# Hotel website — environment variables
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# Anything marked [HOTEL MUST PROVIDE] cannot be guessed and will block launch.
# This file matches backend/config/settings/base.py.
# =============================================================================

# --- Core ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
TIME_ZONE=Africa/Nairobi

# --- Database -----------------------------------------------------------
# Postgres in docker/production. Set USE_SQLITE=true for a quick local run.
USE_SQLITE=false
POSTGRES_DB=hotel
POSTGRES_USER=hotel
POSTGRES_PASSWORD=hotel
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Security (production) ----------------------------------------------
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Hotel brand and business settings ----------------------------------
# These neutral HOTEL_* names are the only place the brand may be configured
# in the backend. The frontend equivalent is src/config/hotel.ts.
# [HOTEL MUST PROVIDE] confirm the final name, address, phone and email.
HOTEL_NAME=West Premier Hotel
HOTEL_SHORT_NAME=West Premier
HOTEL_LEGAL_NAME=West Premier Hotel Ltd
HOTEL_TOWN=Kapenguria
HOTEL_COUNTY=West Pokot
HOTEL_COUNTRY=Kenya
HOTEL_PHONE=+254 20 765 4321
HOTEL_PHONE_HREF=tel:+254207654321
HOTEL_EMAIL=stay@westpremierhotel.co.ke
# The source material has contradictory addresses (Westlands, Nairobi and
# Westlands, Kapenguria). Do not choose one: confirm with the hotel.
HOTEL_ADDRESS=Kapenguria, West Pokot, Kenya

# Cancellation cutoff in hours before check-in. Admin setting, shown to guests.
HOTEL_CANCELLATION_CUTOFF_HOURS=48
# Minutes a booking hold survives while the guest pays.
HOTEL_HOLD_TTL_MINUTES=15
# Front desk response target (minutes) and manager escalation (minutes).
HOTEL_FRONTDESK_TARGET_MINUTES=10
HOTEL_FRONTDESK_ESCALATE_MINUTES=8
# Master switch: while false, unconfirmed marketing claims are hidden publicly.
HOTEL_CLAIMS_VERIFIED=false
HOTEL_GOOGLE_REVIEWS_ENABLED=false

# --- Email / SMTP [HOTEL MUST PROVIDE] ----------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=reservations@example.com
FRONT_DESK_EMAIL=frontdesk@example.com
MANAGER_EMAIL=manager@example.com

# --- M-Pesa Daraja (STK Push) [HOTEL MUST PROVIDE] ----------------------
# Sandbox: https://sandbox.safaricom.co.ke  Production: https://api.safaricom.co.ke
PAYMENTS_SANDBOX=true
MPESA_ENV=sandbox
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://api.example.com/api/v1/payments/webhooks/mpesa/
MPESA_CALLBACK_SECRET=change-me-too
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Omit to derive the reference from HOTEL_SHORT_NAME.
# MPESA_ACCOUNT_REFERENCE=WestPremier
MPESA_SIMULATE=false
# Comma-separated Safaricom callback IPs; empty disables the IP allow-list.
MPESA_ALLOWED_IPS=

# --- Card gateway (stubbed; Pesapal-shaped) [HOTEL MUST PROVIDE] --------
# One of: stub | pesapal | flutterwave | dpo
CARD_GATEWAY=stub
CARD_BASE_URL=https://cybqa.pesapal.com/pesapalv3
CARD_CONSUMER_KEY=
CARD_CONSUMER_SECRET=
CARD_CALLBACK_SECRET=change-me-three

# --- Bank transfer details shown to guests [HOTEL MUST PROVIDE] ---------
BANK_NAME=Equity Bank Kenya
BANK_ACCOUNT_NAME=West Premier Hotel Ltd
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=
BANK_SWIFT=

# --- SMS provider (stubbed; Africa's Talking) [HOTEL MUST PROVIDE] ------
SMS_PROVIDER=stub
SMS_USERNAME=
SMS_API_KEY=
# Omit to derive the sender ID from HOTEL_SHORT_NAME.
# SMS_SENDER_ID=WestPremier
SMS_SEND_ENABLED=false

# --- HotelPlus (no API; vendor blocks third-party access) ----------------
# manual_export (default) writes a daily CSV/PDF for staff to key in.
# api_stub is a placeholder for a future integration and must NOT be enabled.
HOTELPLUS_ADAPTER=manual_export

# --- django-q2 ----------------------------------------------------------
Q_CLUSTER_NAME=hotel_jobs
Q_CLUSTER_WORKERS=2
Q_CLUSTER_TIMEOUT=120
Q_CLUSTER_RETRY=180
Q_CLUSTER_SYNC=false

# --- Frontend (Vite) ----------------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1
