# Copy to .env.staging before starting docker-compose.staging.yml.
# These are staging-only placeholders: never put live payment, SMTP or SMS
# credentials here, and never point staging at a production database.
DJANGO_SETTINGS_MODULE=config.settings.staging
SECRET_KEY=staging-only-change-me-before-use
DEBUG=false
USE_SQLITE=false
ALLOW_DEMO_USERS=false

ALLOWED_HOSTS=localhost,127.0.0.1,proxy
SITE_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080

POSTGRES_DB=hotel
POSTGRES_USER=hotel
POSTGRES_PASSWORD=staging-only-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# One nginx container appends X-Forwarded-For; do not set this higher.
NUM_PROXIES=1

# Local proxy terminates plain HTTP. Set all four to true behind real TLS.
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# Staging uses the console email backend and stub providers. The strict
# production guards deliberately live in config.settings.prod.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=staging@example.com
FRONT_DESK_EMAIL=frontdesk@example.com
MANAGER_EMAIL=manager@example.com
SMS_PROVIDER=stub
SMS_SEND_ENABLED=false

PAYMENTS_SANDBOX=true
PAYMENT_SIMULATION_ALLOWED=true
MPESA_SIMULATE=true
MPESA_ENV=sandbox
CARD_GATEWAY=stub

# Keep unresolved hotel decision flags false in staging too.
HOTEL_CLAIMS_VERIFIED=false
HOTEL_GOOGLE_REVIEWS_ENABLED=false
