{
  "name": "westside-hotel-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "api:types": "openapi-typescript ../backend/openapi.yaml -o src/lib/api-schema.d.ts",
    "check:brand": "python ../scripts/check_brand.py",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:brand",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jiti": "^2.4.2",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.5",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
    "@tanstack/react-query": "^5.107.1",
    "framer-motion": "^14.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@eslint/config-array": {
      "minimatch": "^11.0.5"
    },
    "eslint": {
      "minimatch": "^11.0.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
